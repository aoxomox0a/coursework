# SPARQL Endpoint
SPARQL_ENDPOINT=http://dbpedia.org/sparql

# ChromaDB
CHROMA_DB_PATH=./data/chroma_db

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# API
API_HOST=0.0.0.0
API_PORT=8000

# Indexing
BATCH_SIZE=1000
LIMIT_ENTITIES=10000

# Restrict OpenMP and PyTorch to physical cores
# OMP_NUM_THREADS=8
# MKL_NUM_THREADS=8
# OPENBLAS_NUM_THREADS=8
