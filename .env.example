# SPARQL Endpoint
SPARQL_ENDPOINT=http://dbpedia.org/sparql

# ChromaDB
CHROMA_DB_PATH=./data/chroma_db

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Configuration
LLM_API_KEY=your_hactar_api_key_here
LLM_ENDPOINT=https://hactar.unige.ch/ollama/v1
LLM_MODEL=mistral-7b

# LLM-as-a-Judge model (evaluation only).
# - When unset, the judge uses LLM_MODEL above. That works but incurs the
#   well-documented self-preference bias (~10-15% inflated scores when
#   judge and generator are the same model).
# - Set to a DIFFERENT model on Hactar to mitigate the bias (any model
#   served by the same endpoint works — same key, just a different `model`
#   field in the request payload).
# JUDGE_LLM_MODEL=llama-3-70b

# API
API_HOST=0.0.0.0
API_PORT=8000

# Indexing
BATCH_SIZE=1000
LIMIT_ENTITIES=10000
