# SPARQL Endpoint
SPARQL_ENDPOINT=http://localhost:8890/sparql

# LLM Configuration (Hactar/OpenAI-compatible)
LLM_ENDPOINT=http://localhost:5000
LLM_API_KEY=sk-default
LLM_MODEL=mistral-7b

# Optional: Different model for LLM-as-a-Judge
# JUDGE_LLM_MODEL=gpt-4

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# spaCy Model
SPACY_MODEL=en_core_web_trf

# Database
CHROMA_DB_PATH=./data/chroma_db
