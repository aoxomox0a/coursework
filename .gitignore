# =========================
# 0. Secrets
# =========================
.env
*.rc

# =========================
# 1. Python & Environment
# =========================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# uv virtual environment (CRITICAL: Do not commit the environment)
.venv/
venv/
env/

# =========================
# 2. Machine Learning & Data
# =========================
# Ignore downloaded/fine-tuned Hugging Face models
/tf-model/

# Ignore raw PDFs, interim Excel files, and final datasets — but version
# the curated gold-evaluation set (reproducibility). The trailing /* is
# essential: '/data/' on its own would mark the directory itself as ignored,
# which prevents any re-inclusion of its descendants.
/data/*
!/data/gold/
/data/gold/.cache/

# =========================
# 3. Vector Database
# =========================
# Ignore ChromaDB local storage (prevents committing SQLite binaries)
/project_vector_db/
chroma.sqlite3

# =========================
# 3.b Evaluation runtime artifacts
# =========================
# Per-run evaluation reports (results.json + summary.md) are runtime
# artifacts; reproducible by re-running scripts/evaluate_pipeline.py.
/reports/

# =========================
# 4. IDEs & OS Files
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
logs/*

# =========================
# 6. Testing & Coverage
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# =========================
# 7. Ruff
# =========================
.ruff_cache/
